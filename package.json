{
  "name": "n8n-observability",
  "version": "1.0.2",
  "description": "n8n OpenTelemetry instrumentation. Compatible with Opik and any other OpenTelemetry-compatible backend.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.cjs",
    "./hooks": "./dist/hooks.cjs"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "echo 'no tests yet'",
    "format": "prettier -w .",
    "e2e": "node tests/e2e/run.mjs",
    "example": "docker compose -f examples/e2e/docker-compose.yml up --abort-on-container-exit"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "@arizeai/openinference-instrumentation-langchain": "^3.4.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.1",
    "@opentelemetry/context-async-hooks": "^1.30.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.56.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.56.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "flat": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-core": "^1.112.1",
    "n8n-workflow": "^1.110.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "n8n",
    "opentelemetry",
    "observability",
    "otel",
    "instrumentation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/comet-ml/n8n-observability"
  }
}
